
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/smartride
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# Optional e-mail notifications. Leave SMTP_HOST empty to disable (the app works without it).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SmartRide <no-reply@smartride.local>

# Background maintenance job (expires subscriptions, activates paid renewals, closes orphaned payments).
# Runs inside the API process. Default interval 60000 ms. Set JOBS_ENABLED=false to disable.
JOB_INTERVAL_MS=60000
JOBS_ENABLED=true

# Extend the 30-day trip window for open schedules at most this often (hours).
JOB_EXTEND_TRIPS_HOURS=6

# Road routing used for distance, ETA and fares (OpenStreetMap data). The public demo server is fine for a demo; for real use run your own OSRM.
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=8000

# Optional geocoding provider settings (Nominatim; explicit search only)
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODE_COUNTRIES=in
GEOCODING_USER_AGENT=SmartRide/1.0 (student project)
# Optional contact address recommended by the public geocoding provider
# GEOCODING_CONTACT_EMAIL=your-project-contact@example.com
